# /etc/logrotate.d/eicd - only needed when [log] file is non-empty.
/var/log/eicd.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0640 eicd eicd
    sharedscripts
    postrotate
        # ask the daemon to reopen its log file
        if [ -f /var/lib/eicd/eicd.pid ]; then
            kill -HUP "$(cat /var/lib/eicd/eicd.pid)" 2>/dev/null || true
        fi
    endscript
}
